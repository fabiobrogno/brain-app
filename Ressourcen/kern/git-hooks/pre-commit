#!/bin/sh
# Kortex pre-commit: prüft den gestagten Stand (nur neue Befunde blockieren). Installiert via install-git-hooks.mjs.
# Der Hook liegt im Kern-Ordner (core.hooksPath zeigt hierher), die Prüfung daneben: ein Ordner nach oben.
# Node zuerst im PATH, sonst das private Node der App bzw. des alten Kits. Ohne Node: Commit blockieren (fail closed) —
# sonst liefe die Sicherheitsprüfung auf Passwörter und Schlüssel still nicht.
KERN_ORDNER="$(cd "${0%/*}/.." 2>/dev/null && pwd)"   # nur Shell-Builtins: im Hook-PATH kann dirname fehlen
[ -n "$KERN_ORDNER" ] && [ -f "$KERN_ORDNER/commit-pruefung.mjs" ] || exit 0
NODE=""
if command -v node >/dev/null 2>&1; then NODE=node
else
  S="${BRAIN_APP_SUPPORT:-$HOME/Library/Application Support/Kortex}"
  # Zuerst das Node neben dem Kern: der Kern liegt unter <Support>/bin/kern (stabiler Verweis) bzw. <Support>/kern/<Version>, das Node der App unter <Support>/bin/node[.exe]. Das gilt auf jedem System,
  # auch dort, wo es kein System-Node gibt (Windows/Linux-Pakete bringen ihr eigenes mit). Danach die bekannten Orte je System (Mac, Linux ~/.local/share, Windows %APPDATA%) und das alte Kit.
  for K in "$KERN_ORDNER/../node" "$KERN_ORDNER/../node.exe" "$KERN_ORDNER/../../bin/node" "$KERN_ORDNER/../../bin/node.exe" "$S/bin/node" "$S/bin/node.exe" \
           "${XDG_DATA_HOME:-$HOME/.local/share}/Kortex/bin/node" "$APPDATA/Kortex/bin/node.exe" "$HOME/Library/Application Support/Brain/bin/node" "$HOME/.brain-kit/node/bin/node" "$HOME/.brain-kit/node/node.exe" "$HOME/.brain-kit/node/bin/node.exe"; do
    if [ -x "$K" ]; then NODE="$K"; break; fi
  done
fi
if [ -z "$NODE" ]; then
  echo "Vault-Commit blockiert: Node wurde nicht gefunden, darum kann die Sicherheitsprüfung nicht laufen — öffne die Kortex-App und führe die Einrichtung erneut aus."
  exit 1
fi
exec "$NODE" "$KERN_ORDNER/commit-pruefung.mjs" "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
