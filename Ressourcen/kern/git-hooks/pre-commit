#!/bin/sh
# Brain pre-commit: prüft den gestagten Stand (nur neue Befunde blockieren). Installiert via install-git-hooks.mjs.
# Der Hook liegt im Kern-Ordner (core.hooksPath zeigt hierher), die Prüfung daneben: ein Ordner nach oben.
# Node zuerst im PATH, sonst das private Node der App bzw. des alten Kits. Ohne Node: Commit blockieren (fail closed) —
# sonst liefe die Sicherheitsprüfung auf Passwörter und Schlüssel still nicht.
KERN_ORDNER="$(cd "${0%/*}/.." 2>/dev/null && pwd)"   # nur Shell-Builtins: im Hook-PATH kann dirname fehlen
[ -n "$KERN_ORDNER" ] && [ -f "$KERN_ORDNER/commit-pruefung.mjs" ] || exit 0
NODE=""
if command -v node >/dev/null 2>&1; then NODE=node
else
  S="${BRAIN_APP_SUPPORT:-$HOME/Library/Application Support/Kortex}"
  for K in "$S/bin/node" "$HOME/Library/Application Support/Brain/bin/node" "$HOME/.brain-kit/node/bin/node" "$HOME/.brain-kit/node/node.exe" "$HOME/.brain-kit/node/bin/node.exe"; do
    if [ -x "$K" ]; then NODE="$K"; break; fi
  done
fi
if [ -z "$NODE" ]; then
  echo "Brain-Commit blockiert: Node wurde nicht gefunden, darum kann die Sicherheitsprüfung nicht laufen — öffne die Kortex-App und führe die Einrichtung erneut aus."
  exit 1
fi
exec "$NODE" "$KERN_ORDNER/commit-pruefung.mjs" "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
