#!/bin/sh
# git-sicher — der einzige Weg, auf dem der Kern git startet (werkzeug.mjs#gitBefehl liefert den Pfad dieser Datei).
#
# Vault-Inhalte dürfen nie ein Programm starten, nie nachladen und nie außerhalb des Vaults schreiben (Kern-Umzug P4, Sicherheit): Ein
# geklonter oder entpackter fremder Vault bringt seine eigene .git/config, .gitattributes und .git-Datei mit. Darum
#  1. wird git nur über feste Orte gefunden (Homebrew, /usr/local, /usr/bin), nie über PATH oder einen Pfad aus dem Vault.
#     Die Umgebungsvariablen BRAIN_GIT_PROGRAMM (absoluter git-Pfad), BRAIN_GIT_HOOKS_ERLAUBT (Hook-Ordner, durch ":" getrennt) und
#     BRAIN_TAGESLAUF_CACHE gelten nur in der Testumgebung (KORTEX_KERN_UNSTABIL_ERLAUBT=1 oder BRAIN_TESTMODUS=1); dort sind auch
#     lokale Remote-Adressen (absoluter Pfad, file:///) erlaubt, in der Produktion nie (ein Push startet die Hooks des Ziel-Repos);
#  2. gilt für die lokale Konfiguration des Repos (local, worktree, auch per include.path — das ist selbst verboten) eine ERLAUBNISLISTE
#     (git-sicher-pruefung.pl, fail-closed): jeder Schlüssel muss auf der Liste harmloser Schlüssel stehen und einen zulässigen Wert haben,
#     sonst Exit 126 mit dem Namen des Schlüssels (nie dem Wert). Unbekanntes ist verboten — auch Schlüssel, an die niemand gedacht hat
#     (http.*, url.*.insteadOf, man.*.cmd, submodule.*.update, remote.*.proxy …). Eine Sperrliste bekannter Programm-Schlüssel ließe sich
#     umgehen (ein „=“ im Unterabschnitt, ein Wert ohne Wahrheitswert …). Folgen: Vaults mit lokalem credential.helper, core.sshCommand,
#     Filter-/Diff-/Merge-Treibern (git-lfs), Partial Clone u. a. arbeiten im Kern ohne git; der Helper gehört in die globale Konfiguration;
#  3. laufen alle Unterbefehle außer `config` und `version` mit Befehlszeilen-Einstellungen, die die des Vaults schlagen — dieselben wie die
#     Werkstatt (Ressourcen/gemeinsam/git.mjs: GRUND, OHNE_HOOKS, OHNE_SIGNIEREN; Test: Tests/Node/kern-git-haertung.test.mjs):
#     kein core.fsmonitor, keine Hooks (core.hooksPath=/dev/null), kein ext::-Transport, keine Submodule, keine Signierung.
#     Einzige Ausnahme für Hooks: ist core.hooksPath der Repo-Konfiguration genau der Ordner git-hooks DIESES Kerns (so richtet
#     install-git-hooks.mjs den Schutz ein, den auch die Pflege-Arbeitskopien brauchen), laufen diese Hooks — Code aus dem Kern, nie
#     aus dem Vault; jeder andere Wert und jedes .git/hooks/ im Vault bleibt aus. `help` und `submodule` gibt es nicht;
#  4. verweigert die Datei den Dienst — auch für `config` —, wenn der Arbeitsbaum oder ein Git-Verzeichnis aus dem Ordner hinauszeigt, in dem sie
#     läuft (-C), oder irgendwo im Git-Verzeichnis (ohne Objektinhalte und Hooks) ein Verweis liegt (git schriebe über logs/HEAD,
#     COMMIT_EDITMSG, FETCH_HEAD … nach draußen):
#     kein Arbeitsbaum feststellbar, ein Arbeitsbaum, der kein Elternordner des Ordners ist, ein gemeinsames Git-Verzeichnis außerhalb des
#     Arbeitsbaums (`.git` als Datei mit gitdir: nach draußen) oder objects/info/alternates (fremde Objekte). core.worktree/core.bare
#     stehen nicht auf der Erlaubnisliste. Ausgenommen sind die Arbeitskopien des Tageslaufs unter
#     <Home>/Library/Caches/brain-tageslauf (verknüpfte Arbeitsbäume des Vaults, vom Kern selbst angelegt);
#  5. werden geerbte GIT_DIR/GIT_WORK_TREE (außer im Hook, erkennbar an GIT_INDEX_FILE, und nur wenn GIT_DIR unter dem -C-Ordner liegt) und GIT_CONFIG_PARAMETERS/GIT_CONFIG_COUNT/
#     GIT_CONFIG_KEY_*/GIT_CONFIG_VALUE_* geleert; es gelten GIT_TERMINAL_PROMPT=0, GIT_EDITOR=: , kein Pager, GIT_NO_LAZY_FETCH=1 und IMMER ein
#     ssh ohne Rückfrage (GIT_SSH_COMMAND; die globale Einstellung des Nutzers bleibt bei Netzbefehlen erhalten).
# Bewusst NICHT erzwungen: http.sslVerify, http.proxy, http.cookieFile, http.curloptResolve u. ä. Lokal sind sie nicht erlaubt (Punkt 2), und
# system/global sind die Einstellungen des Nutzers selbst (Firmen-Proxy, eigene Zertifikate) — sie zu überschreiben bräche seine Anmeldung.
# `config` bekommt die Lage- und Verweisprüfung (Punkt 4), aber keine Erlaubnisliste und bleibt sonst unverändert (install-git-hooks.mjs liest und
# schreibt core.hooksPath); `version` läuft ungeprüft.
LC_ALL=C
export LC_ALL

TEST=0
if [ "$KORTEX_KERN_UNSTABIL_ERLAUBT" = 1 ] || [ "$BRAIN_TESTMODUS" = 1 ]; then TEST=1; fi

ECHT=
if [ "$TEST" = 1 ] && [ -n "$BRAIN_GIT_PROGRAMM" ]; then
  case "$BRAIN_GIT_PROGRAMM" in
    /*) [ -x "$BRAIN_GIT_PROGRAMM" ] && ECHT="$BRAIN_GIT_PROGRAMM" ;;
  esac
else
  for g in /opt/homebrew/bin/git /usr/local/bin/git /usr/bin/git; do
    if [ -x "$g" ]; then ECHT="$g"; break; fi
  done
fi
if [ -z "$ECHT" ]; then echo "git-sicher: git wurde nicht gefunden." >&2; exit 127; fi

# Unterbefehl und -C-Ordner aus den Optionen vor dem Unterbefehl lesen
dir=.; sub=; skip=0
for a in "$@"; do
  if [ "$skip" = C ]; then dir="$a"; skip=0; continue; fi
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    -C) skip=C ;;
    -c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env) skip=1 ;;
    -*) ;;
    *) sub="$a"; break ;;
  esac
done

case "$sub" in
  ""|version) exec "$ECHT" "$@" ;;
esac

verweigere() { echo "git-sicher: git ist für diesen Ordner gesperrt: $1" >&2; exit 126; }
# Geerbte Umlenkungen und eingeschleuste Konfiguration verwerfen. GIT_DIR/GIT_WORK_TREE bleiben nur im Hook (git setzt dort GIT_INDEX_FILE)
# UND nur, wenn GIT_DIR unter dem -C-Ordner liegt.
unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
gi=0; while [ "$gi" -lt 256 ]; do unset "GIT_CONFIG_KEY_$gi" "GIT_CONFIG_VALUE_$gi"; gi=$((gi + 1)); done
if [ -n "$GIT_INDEX_FILE" ] && [ -n "$GIT_DIR" ]; then
  gd=$(cd "$dir" 2>/dev/null && cd "$GIT_DIR" 2>/dev/null && pwd -P); dd=$(cd "$dir" 2>/dev/null && pwd -P)
  case "$gd/" in "$dd"/*) [ -n "$gd" ] && [ -n "$dd" ] || unset GIT_DIR GIT_WORK_TREE ;; *) unset GIT_DIR GIT_WORK_TREE ;; esac
else
  unset GIT_DIR GIT_WORK_TREE
fi
case "$sub" in
  help|submodule) verweigere "der Unterbefehl $sub ist im Kern nicht vorgesehen." ;;
esac
# nur Shell-Builtins (kein dirname): im Hook-PATH fehlen Hilfsprogramme
case "$0" in */*) kerndir=$(cd "${0%/*}" 2>/dev/null && pwd -P) ;; *) kerndir=$(pwd -P) ;; esac

pruefen=0
hp=
# init, clone und merge-file (reine Dateioperation) ohne -C: das Arbeitsverzeichnis ist nicht das Ziel, seine Konfiguration zählt nicht;
# config mit --global/--system/--file ohne -C ebenso (kein Repository im Spiel)
if [ "$sub" = config ]; then
  extern=0
  for a in "$@"; do case "$a" in --global|--system|--file|--file=*|-f|--blob|--blob=*) extern=1 ;; esac; done
  if [ "$dir" != . ] || [ "$extern" = 0 ]; then pruefen=1; fi
elif [ "$dir" != . ] || { [ "$sub" != init ] && [ "$sub" != clone ] && [ "$sub" != merge-file ]; }; then
  pruefen=1
fi
# Erlaubnisliste der Konfiguration: für jeden Unterbefehl außer config (config liest und schreibt nur; die Lage-/Verweisprüfung unten gilt auch dort)
if [ "$pruefen" = 1 ] && [ "$sub" != config ]; then
  [ -f "$kerndir/git-sicher-pruefung.pl" ] && [ -x /usr/bin/perl ] || verweigere "die Prüfung der Konfiguration fehlt (git-sicher-pruefung.pl oder perl)."
  res=$(/usr/bin/perl "$kerndir/git-sicher-pruefung.pl" "$ECHT" "$dir" 2>/dev/null)
  if [ $? -ne 0 ]; then
    schluessel=$(printf '%s\n' "$res" | /usr/bin/awk -F'\t' '$1=="REFUSE"{print $2; exit}')
    verweigere "die Konfiguration enthält ${schluessel:-(Prüfung fehlgeschlagen)}, das nicht auf der Erlaubnisliste harmloser Schlüssel steht."
  fi
  hp=$(printf '%s\n' "$res" | /usr/bin/awk -F'\t' '$1=="HOOKSPATH"{sub(/^HOOKSPATH\t/, ""); print; exit}')
fi

# Arbeitsbaum und Git-Verzeichnisse müssen im Ordner liegen, in dem wir laufen, und dürfen keine Verweise enthalten (fail-closed: ohne
# feststellbaren Arbeitsbaum kein git; init, clone und config dürfen in einen Ordner, der noch kein Repository ist)
if [ "$pruefen" = 1 ]; then
  lage=$("$ECHT" -C "$dir" -c core.fsmonitor=false -c core.hooksPath=/dev/null \
    rev-parse --path-format=absolute --show-toplevel --git-common-dir --absolute-git-dir 2>/dev/null)
  top=$(printf '%s\n' "$lage" | /usr/bin/sed -n 1p)
  common=$(printf '%s\n' "$lage" | /usr/bin/sed -n 2p)
  gitdir=$(printf '%s\n' "$lage" | /usr/bin/sed -n 3p)
  if [ -z "$top" ] || [ -z "$common" ] || [ -z "$gitdir" ]; then
    case "$sub" in init|clone|config) ;; *) verweigere "kein Arbeitsbaum festzustellen (kein Repository oder nicht lesbar)." ;; esac
  else
    top=$(cd "$top" 2>/dev/null && pwd -P)
    common=$(cd "$common" 2>/dev/null && pwd -P)
    gitdir=$(cd "$gitdir" 2>/dev/null && pwd -P)
    hier=$(cd "$dir" 2>/dev/null && pwd -P)
    [ -n "$top" ] && [ -n "$common" ] && [ -n "$gitdir" ] && [ -n "$hier" ] || verweigere "Arbeitsbaum oder Git-Verzeichnis sind nicht lesbar."
    case "$hier/" in "$top"/*) ;; *) verweigere "der Arbeitsbaum ($top) liegt nicht über dem Ordner ($hier)." ;; esac
    cache=
    if [ -n "$HOME" ]; then cache=$(cd "$HOME/Library/Caches/brain-tageslauf" 2>/dev/null && pwd -P); fi
    if [ "$TEST" = 1 ] && [ -n "$BRAIN_TAGESLAUF_CACHE" ]; then cache2=$(cd "$BRAIN_TAGESLAUF_CACHE" 2>/dev/null && pwd -P); else cache2=; fi
    kopie=0
    for c in "$cache" "$cache2"; do
      if [ -n "$c" ]; then case "$top/" in "$c"/*) kopie=1 ;; esac; fi
    done
    if [ "$kopie" = 0 ]; then
      case "$common/" in "$top"/*) ;; *) verweigere "das Git-Verzeichnis ($common) liegt außerhalb des Arbeitsbaums ($top)." ;; esac
      case "$gitdir/" in "$top"/*) ;; *) verweigere "das Git-Verzeichnis dieses Arbeitsbaums ($gitdir) liegt außerhalb des Arbeitsbaums ($top)." ;; esac
    fi
    [ ! -e "$common/objects/info/alternates" ] || verweigere "objects/info/alternates verweist auf fremde Objekte."
    # Verweise im Git-Verzeichnis lassen git nach draußen schreiben (logs/HEAD, COMMIT_EDITMSG, FETCH_HEAD, objects …): keiner ist erlaubt.
    # Objektinhalte (objects/??/*, objects/pack/*) und Hook-Dateien (laufen nie) werden übersprungen, damit der Lauf schnell bleibt.
    dirs="$common"
    if [ "$gitdir" != "$common" ]; then case "$gitdir/" in "$common"/*) ;; *) dirs="$common
$gitdir" ;; esac; fi
    IFS_ALT=$IFS; IFS='
'
    for d in $dirs; do
      IFS=$IFS_ALT
      verweis=$(/usr/bin/find "$d" \( -path "$d/objects/??/*" -o -path "$d/objects/pack/*" -o -path "$d/hooks/*" \) -prune -o -type l -print -quit 2>/dev/null)
      [ -z "$verweis" ] || verweigere "im Git-Verzeichnis liegt ein Verweis (${verweis##*/}); git würde darüber nach draußen schreiben."
      IFS='
'
    done
    IFS=$IFS_ALT
  fi
fi

# config liest und schreibt nur: nach der Lage- und Verweisprüfung unverändert ausführen (install-git-hooks.mjs verlässt sich darauf)
if [ "$sub" = config ]; then exec "$ECHT" "$@"; fi

GIT_TERMINAL_PROMPT=0; GIT_EDITOR=:; GIT_SEQUENCE_EDITOR=:; GIT_PAGER=cat; GIT_NO_LAZY_FETCH=1
export GIT_TERMINAL_PROMPT GIT_EDITOR GIT_SEQUENCE_EDITOR GIT_PAGER GIT_NO_LAZY_FETCH
if [ -z "$GIT_SSH_COMMAND" ]; then
  GIT_SSH_COMMAND=
  case "$sub" in
    fetch|pull|push|clone|ls-remote|remote)
      GIT_SSH_COMMAND=$("$ECHT" -c core.fsmonitor=false config --global --get core.sshcommand 2>/dev/null) ;;
  esac
  [ -n "$GIT_SSH_COMMAND" ] || GIT_SSH_COMMAND="ssh -o BatchMode=yes"
  export GIT_SSH_COMMAND
fi

# Hooks nur aus dem Hook-Ordner dieses Kerns (siehe Kopf)
HOOKS=/dev/null
case "$hp" in
  /*) real=$(cd "$hp" 2>/dev/null && pwd -P)
      if [ -n "$real" ] && [ -n "$kerndir" ] && [ "$real" = "$kerndir/git-hooks" ]; then HOOKS="$real"; fi
      if [ "$TEST" = 1 ] && [ -n "$real" ] && [ -n "$BRAIN_GIT_HOOKS_ERLAUBT" ]; then
        alt_ifs=$IFS; IFS=:
        for h in $BRAIN_GIT_HOOKS_ERLAUBT; do
          [ -n "$h" ] && [ "$(cd "$h" 2>/dev/null && pwd -P)" = "$real" ] && HOOKS="$real"
        done
        IFS=$alt_ifs
      fi ;;
esac

exec "$ECHT" -c core.fsmonitor=false -c "core.hooksPath=$HOOKS" -c protocol.ext.allow=never \
  -c submodule.recurse=false -c fetch.recurseSubmodules=false -c push.recurseSubmodules=no \
  -c diff.ignoreSubmodules=all -c status.submoduleSummary=false -c safe.bareRepository=explicit \
  -c commit.gpgSign=false -c tag.gpgSign=false -c push.gpgSign=false \
  "$@"
